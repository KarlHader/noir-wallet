{
  "name": "@noir-wallet/shield-sdk",
  "version": "0.1.0-beta.0",
  "private": true,
  "description": "TypeScript SDK for Noir Wallet NEAR Confidential Shield requests",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/protocol.ts --format cjs,esm --dts --out-dir dist --clean --no-splitting",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register.mjs --test tests/*.test.mjs",
    "pack:dry": "npm pack --dry-run --ignore-scripts",
    "example:dev": "pnpm --filter @noir-wallet/shield-example dev",
    "example:type-check": "pnpm --filter @noir-wallet/shield-example type-check",
    "example:build": "pnpm --filter @noir-wallet/shield-example build"
  },
  "devDependencies": {
    "@noir-wallet/sdk": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
