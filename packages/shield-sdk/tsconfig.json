{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@noir-wallet/sdk": ["../sdk/src/index.ts"]
    }
  },
  "include": ["src"]
}
