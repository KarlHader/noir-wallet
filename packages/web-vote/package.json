{
  "name": "@noir-wallet/web-vote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local --port 8788 --persist-to ../../output/web-vote/state",
    "deploy": "wrangler deploy --env=\"\"",
